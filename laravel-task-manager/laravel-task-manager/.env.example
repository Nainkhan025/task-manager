APP_NAME="Task Manager"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- SQLite (simplest, no server needed) ---
DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database/database.sqlite   (Laravel 11 defaults this for you)

# --- MySQL (uncomment and fill in if you prefer MySQL) ---
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=task_manager
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
